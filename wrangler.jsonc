{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "norweigenlearn",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-23",
  "vars": {
    "SUPABASE_URL": "https://btdphbudhnqxobybdvog.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_QsxWJW4vMavKNs_5I1Pc_Q_P2wl4qpO"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norweigenlearn",
      "database_id": "fc3a76fa-061b-44f0-86bd-a8e541bd4bfc",
      "migrations_dir": "migrations"
    }
  ]
}
